{
  "name": "audimage/backend",
  "description": "AUDIMAGE backend with PSR-4 autoloading and modular services.",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php migrations/migrate.php"
  }
}
